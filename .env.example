
# Contoh konfigurasi SegiPintar
# Salin file ini menjadi .env untuk penggunaan lokal.
# Jangan pernah memasukkan API key asli ke file ini.

# --- Chatbot Tanya Pembimbing ---

# Mode: deepseek | tiruan | mati
# deepseek = menggunakan API melalui OpenRouter
# tiruan   = menggunakan balasan contoh untuk pengujian
# mati     = chatbot dinonaktifkan

SEGIPINTAR_ASISTEN=tiruan

# Pengaturan OpenRouter
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4-flash:free

# --- Batas penggunaan chatbot ---

ASISTEN_BATAS_WAKTU=40
ASISTEN_MAKS_TOKEN=300
ASISTEN_MAKS_PESAN_PER_MISI=30
ASISTEN_MAKS_PANJANG_PESAN=500

# --- Keamanan dan anonimisasi siswa ---

# Isi dengan teks acak yang panjang.
# Jangan diganti selama penelitian berlangsung.

SEGIPINTAR_RAHASIA_ANONIM=

# --- PIN Guru ---

SEGIPINTAR_PIN_GURU=
